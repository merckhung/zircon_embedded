import("//build/cpp/library_headers.gni")
import("//build/test.gni")

library_headers("headers") {
  headers = [ "lib/linux-initramfs/initramfs.h" ]
  if (is_kernel) {
    public_deps = [
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/libc",
    ]
  }
}

static_library("linux-initramfs") {
  public_deps = [ ":headers" ]
  sources = [ "initramfs.cc" ]
}

group("tests") {
  testonly = true
  deps = [ ":linux-initramfs-unittests($host_toolchain)" ]
}

if (!is_kernel) {
  test("linux-initramfs-unittests") {
    sources = [ "initramfs-tests.cc" ]
    deps = [
      ".",
      "//src/lib/fxl/test:gtest_main",
      "//third_party/googletest:gmock",
    ]
  }
}
