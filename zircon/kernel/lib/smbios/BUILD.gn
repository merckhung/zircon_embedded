import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "lib/smbios/smbios.h" ]
  public_deps = [ "//zircon/system/ulib/zx" ]
}

static_library("smbios") {
  public_deps = [ ":headers" ]
  sources = [ "smbios.cc" ]
  deps = [ "//zircon/system/ulib/fbl" ]
}

group("tests") {
  testonly = true
  deps = [
    "rust:tests",
    "test:tests",
  ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
