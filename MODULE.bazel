module(
    name = "zircon_embedded",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")

zircon_ext = use_extension("//bazel:zircon_repo.bzl", "zircon_ext")
use_repo(zircon_ext, "zircon_toolchains")

alpine_ext = use_extension("//bazel:alpine_repo.bzl", "alpine_ext")
use_repo(alpine_ext, "alpine_x86_64", "alpine_aarch64")
